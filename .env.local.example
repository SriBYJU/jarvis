# ── J.A.R.V.I.S. v2.0 Environment Variables ──────────────────────
# Copy this file to .env.local and fill in your API keys

# LLM — OpenRouter (get free key: https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...

# LLM Fallback — Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# YouTube Data API v3 (https://console.cloud.google.com/apis/library/youtube.googleapis.com)
YOUTUBE_API_KEY=

# Google Custom Search (https://programmablesearchengine.google.com/)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# OpenWeatherMap (https://home.openweathermap.org/api_keys)
OPENWEATHER_API_KEY=

# Finnhub Stocks (https://finnhub.io/register)
FINNHUB_API_KEY=

# NewsAPI (https://newsapi.org/register)
NEWS_API_KEY=

# Base URL (change for production)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
