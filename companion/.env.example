# J.A.R.V.I.S. Local Core v4
# No paid AI API key is required for the local core.

# Local AI
OLLAMA_URL=http://127.0.0.1:11434
JARVIS_MODEL=qwen3:4b
JARVIS_KEEP_ALIVE=30m
JARVIS_PORT=3003
JARVIS_MCP_PORT=3004
JARVIS_SPOTIFY_PORT=3005
JARVIS_BROWSER_PORT=3006
JARVIS_REALTIME_PORT=3007

# Browser automation
# Default: use installed Google Chrome with a separate persistent JARVIS profile.
JARVIS_BROWSER_CHANNEL=chrome
JARVIS_CHROME_PATH=
JARVIS_BROWSER_PROFILE=

# Web origins allowed to talk to local machine services.
# Comma-separated exact origins. localhost and https://sribyju.github.io are allowed by default.
JARVIS_WEB_ORIGINS=

# Optional extra folders Jarvis may access.
# Windows example: C:\Users\you\Projects;D:\School
# macOS/Linux example: /Users/you/Projects:/Users/you/School
JARVIS_WORKSPACES=

# Integrations — leave blank until setup. Never commit real values.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3005/spotify/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
BUFFER_ACCESS_TOKEN=
GITHUB_TOKEN=

# Optional MCP command adapters.
GMAIL_MCP_COMMAND=
GOOGLE_CALENDAR_MCP_COMMAND=
BUFFER_MCP_COMMAND=
