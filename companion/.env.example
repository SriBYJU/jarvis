# J.A.R.V.I.S. Local Core v3
# No paid AI API key is required for the core.

# Local AI
OLLAMA_URL=http://127.0.0.1:11434
JARVIS_MODEL=qwen3:4b
JARVIS_PORT=3003

# Optional extra folders Jarvis may access.
# Windows example: C:\Users\you\Projects;D:\School
# macOS/Linux example: /Users/you/Projects:/Users/you/School
JARVIS_WORKSPACES=

# Integrations — leave blank until setup. Never commit real values.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3003/oauth/spotify/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
BUFFER_ACCESS_TOKEN=
GITHUB_TOKEN=

# Optional MCP command adapters. These are command strings configured locally,
# not credentials that should be committed to GitHub.
GMAIL_MCP_COMMAND=
GOOGLE_CALENDAR_MCP_COMMAND=
BUFFER_MCP_COMMAND=
